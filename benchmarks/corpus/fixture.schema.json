{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/main/benchmarks/corpus/fixture.schema.json",
  "title": "ARWP Resolver Benchmark Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "url", "ownership", "reviewedAt", "accepted", "evidence"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "ownership": { "enum": ["independent", "project-reference", "example-only"] },
    "reviewedAt": { "type": "string", "format": "date" },
    "accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "search", "structured", "tools", "agent"],
      "properties": {
        "read": { "$ref": "#/$defs/acceptedInterfaces" },
        "search": { "$ref": "#/$defs/acceptedInterfaces" },
        "structured": { "$ref": "#/$defs/acceptedInterfaces" },
        "tools": { "$ref": "#/$defs/acceptedInterfaces" },
        "agent": { "$ref": "#/$defs/acceptedInterfaces" }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "note"],
        "properties": {
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "note": { "type": "string", "minLength": 3, "maxLength": 1000 },
          "sourceType": { "type": "string", "maxLength": 100 }
        }
      }
    },
    "note": { "type": "string", "maxLength": 2000 }
  },
  "$defs": {
    "acceptedInterfaces": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "oneOf": [
          { "type": "string", "format": "uri", "pattern": "^https://" },
          {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "url": { "type": "string", "format": "uri", "pattern": "^https://" },
              "protocol": { "type": "string", "minLength": 1, "maxLength": 100 },
              "kind": { "type": "string", "minLength": 1, "maxLength": 100 },
              "transport": { "type": "string", "minLength": 1, "maxLength": 100 }
            }
          }
        ]
      }
    }
  }
}
