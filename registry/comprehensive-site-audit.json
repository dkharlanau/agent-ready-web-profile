{
  "version": "0.2",
  "name": "ARWP Comprehensive Site Audit",
  "reviewedAt": "2026-09-16",
  "purpose": "Make a whole-site ARWP application coverage-explicit. Bounded cohorts remain useful preflight evidence but cannot prove whole-site coverage. Applicable rules must be evaluated explicitly instead of being silently omitted because they have lower priority or live in a specialist layer.",
  "truthBoundaries": [
    "Repository declarations are not deployed runtime evidence.",
    "A successful build is not proof that the deployed artifact matches the build.",
    "Raw HTTP HTML is not proof of rendered browser behavior when JavaScript materially changes the page.",
    "A green bounded cohort is not a whole-site pass.",
    "Automated accessibility checks are not a WCAG conformance claim.",
    "Lab performance is not field Core Web Vitals evidence.",
    "Valid structured data does not guarantee a Search feature.",
    "Search, AI and business outcomes require owner/provider evidence.",
    "Priority determines remediation order; it never permits an applicable rule to be skipped."
  ],
  "linkedContracts": [
    "registry/content-page-quality-contract.json",
    "registry/search-release-practices.json",
    "registry/internal-discovery-distribution-practices.json",
    "registry/image-discovery-practices.json",
    "registry/image-quality-practices.json"
  ],
  "applicabilityLedger": {
    "required": true,
    "priorityDoesNotPermitSkipping": true,
    "allowedStates": ["pass", "fail", "watch", "owner-data", "not-applicable", "unknown"],
    "notApplicableRequiresReason": true,
    "unknownIsNotPass": true,
    "rule": "For every canonical page and every site/system surface, classify all applicable audit-domain and linked-contract requirements. A complete/strict report must not omit a rule because it is P2, because a bounded tool did not inspect it, or because a template was assumed to cover every route.",
    "contentDetailRule": "Every route classified as a content/detail page must evaluate every requirement in registry/content-page-quality-contract.json against the final artifact, with runtime evidence for every distinct interactive implementation plus every changed/high-risk page."
  },
  "coverageContract": {
    "inventorySources": [
      "repository routes and content collections",
      "deterministic build output",
      "robots.txt sitemap declarations",
      "sitemap indexes and leaf sitemaps",
      "same-origin crawlable links",
      "hreflang and canonical targets",
      "feeds when present",
      "first-party URLs declared in structured data",
      "redirects, pagination, locale variants and generated route states"
    ],
    "pageLedgerRequiredFields": [
      "url",
      "canonicalOwner",
      "routeArchetype",
      "templateOrLayout",
      "locale",
      "inventorySources",
      "expectedIndexability",
      "applicableContracts",
      "auditState",
      "findings",
      "evidence"
    ],
    "coverageStates": {
      "complete": "Every enumerable in-scope canonical page received all applicable deterministic page checks and required site/system surfaces were checked.",
      "runtime-complete": "Complete plus rendered browser/runtime verification on every in-scope page.",
      "template-runtime-complete": "Complete deterministic page coverage plus rendered/runtime verification for every route archetype/template and every high-risk or changed page.",
      "partial": "Some discovered pages or applicable checks were sampled, capped, rate-limited or skipped.",
      "unknown": "The inventory cannot be reconciled or an important source/build/deployment surface cannot be inspected."
    },
    "fullAuditClaimRequires": [
      "coverageState is complete, runtime-complete or template-runtime-complete",
      "no unexplained inventory or canonical-owner gaps",
      "every applicable domain and linked-contract rule has explicit evidence or an explicit watch/owner-data/not-applicable/unknown state",
      "every content/detail page has a content-page-quality applicability row and final-artifact evidence",
      "bounded tools are labelled preflight/supplemental rather than whole-site proof",
      "every exclusion and not-applicable state has a reason",
      "tested revision and deployment identity are recorded when repository changes are part of the task"
    ],
    "largeSitePolicy": "Prefer complete repository/build analysis for every page, then chunk public checks conservatively. If every live/rendered page cannot be checked safely, report template-runtime-complete or partial rather than runtime-complete."
  },
  "evidenceLayers": [
    "repository",
    "build",
    "deployed-http",
    "rendered-browser",
    "owner-platform"
  ],
  "auditDomains": [
    {
      "id": "inventory-and-deployment",
      "priority": "P0",
      "checks": ["route/content/build/sitemap/link reconciliation", "canonical owners and aliases", "route archetypes/templates/locales", "content/detail page-family classification", "source-build-deploy revision parity", "host and HTTPS normalization", "404/410 and soft-404 behavior"]
    },
    {
      "id": "http-crawl-index-canonical",
      "priority": "P0",
      "checks": ["expected HTTP state", "redirects", "robots and crawler-specific access", "meta/X-Robots-Tag", "canonical consistency", "sitemap/indexability parity", "pagination/filter/parameter policy", "hreflang reciprocity"]
    },
    {
      "id": "head-search-appearance-social",
      "priority": "P0",
      "checks": ["title uniqueness and source convergence", "description quality", "charset/viewport/lang", "favicon and site identity", "Open Graph title/description/url/type", "intentional social card metadata", "representative og:image and image alt", "preferred image", "canonical/social URL convergence", "snippet pollution"]
    },
    {
      "id": "content-page-quality-distribution",
      "priority": "P0",
      "contract": "registry/content-page-quality-contract.json",
      "checks": ["content/detail applicability classification", "all CPQ requirements evaluated page-complete", "end-of-content distribution footer", "Share and Copy link", "at least two configured direct provider share destinations", "canonical share payload", "native Share progressive enhancement and Copy fallback", "sharing accessibility and failure behavior", "feedback sink integrity when feedback UI exists", "no fake reaction counts or false recorded state", "runtime coverage for each distinct distribution implementation", "final-artifact family-wide CI gate"]
    },
    {
      "id": "structured-data-entities-provenance",
      "priority": "P1",
      "checks": ["JSON-LD parsing", "page-type fit", "visible-fact parity", "stable @id reuse", "cross-page entity consistency", "truthful authors/dates/prices/ratings/licenses/provenance"]
    },
    {
      "id": "content-quality-and-evidence",
      "priority": "P1",
      "checks": ["clear page job", "standalone usefulness", "original contribution", "claim/source support", "thin/duplicate/stale content", "heading hierarchy", "placeholder/debug filler", "truthful freshness", "important citation health"]
    },
    {
      "id": "internal-discovery-information-architecture",
      "priority": "P1",
      "checks": ["intentional discovery path", "crawlable descriptive links", "breadcrumbs", "hub/detail/reverse relations", "orphans/global-only pages", "dead ends", "continuation after content", "canonical link targets", "all internal links and critical assets"]
    },
    {
      "id": "accessibility-wcag22",
      "priority": "P1",
      "checks": ["landmarks/headings", "image alternatives", "name-role-value/state", "form labels/errors", "keyboard operation", "visible unobscured focus", "target size/input alternatives", "contrast/non-color cues", "zoom/reflow", "reduced motion", "captions/transcripts", "document language", "share/copy/feedback accessible names and states", "manual review before conformance claims"]
    },
    {
      "id": "performance-and-delivery",
      "priority": "P1",
      "checks": ["field LCP/INP/CLS when owner data exists", "lab diagnostics", "transfer/request outliers", "render-blocking/client-JS risk", "image byte and intrinsic-vs-rendered inventory", "responsive image variants/dimensions", "offscreen lazy loading and critical/LCP image priority", "social/share image delivery", "font policy", "compression/cache validators", "third-party weight", "layout shifts"]
    },
    {
      "id": "mobile-responsive-visual",
      "priority": "P1",
      "checks": ["viewport/overflow", "mobile navigation/dialogs/sticky UI", "readability", "touch targets", "interstitial obstruction", "distribution footer fit", "breakpoint hierarchy", "visual regressions"]
    },
    {
      "id": "runtime-js-functionality",
      "priority": "P0",
      "checks": ["raw-vs-rendered content parity", "console/network errors", "hydration", "SPA deep links/history", "links/buttons/menus/dialogs", "forms and validation", "search/filter/sort/pagination", "empty/error states", "native Share support/cancel/failure paths", "Copy link fallback", "direct provider share targets", "feedback success/failure when implemented", "downloads", "third-party failure resilience"]
    },
    {
      "id": "security-privacy",
      "priority": "P1",
      "checks": ["HTTPS/mixed content", "security response headers", "framing/referrer/permissions policy applicability", "Web Share permissions policy compatibility when used", "external script review", "cookies/analytics inventory", "privacy/consent applicability", "share/feedback URL data leakage", "deeper app-security gate for accounts/uploads/forms", "no private owner data in public artifacts"]
    },
    {
      "id": "media-images-video-downloads",
      "priority": "P1",
      "checks": ["media URL/content type", "exact image bytes and intrinsic dimensions", "largest rendered dimensions and responsive overdelivery", "format choice and quality-preserving optimization", "width/height and lazy/eager/fetch-priority policy", "semantic stable image filenames and reference integrity", "alt/context/captions/transcripts", "preferred/social images", "social crop/legibility where applicable", "media sitemap applicability", "creator/provenance/license/visible credit truth", "publisher-specific image attribution policy", "duplicate/unused image variants", "download metadata"]
    },
    {
      "id": "localization-internationalization",
      "priority": "P1",
      "checks": ["lang declaration", "localized route inventory", "hreflang equivalence", "untranslated gaps", "locale formatting", "locale switcher behavior", "localized metadata/structured-data parity", "localized share labels and page-specific share text"]
    },
    {
      "id": "trust-identity-legal",
      "priority": "P1",
      "checks": ["operator/publisher consistency", "about/contact/author identity when useful", "copyright/license/trademark", "privacy/data-use when applicable", "terms/refund/submission rules when applicable", "security contact when applicable", "corrections/version history when useful", "no fabricated feedback/social proof"]
    },
    {
      "id": "analytics-measurement-observability",
      "priority": "P1",
      "checks": ["analytics configuration and duplicate firing", "important task/conversion events", "share/copy/provider-click events when intentionally measured", "feedback event sink when feedback UI exists", "share intent not mislabeled as confirmed external publication", "Search Console/Bing owner gates", "AI referrals/crawler logs when relevant", "provider-native denominators", "private measurement data kept out of public artifacts"]
    },
    {
      "id": "ai-agent-readiness",
      "priority": "P1",
      "checks": ["OAI-SearchBot policy separate from GPTBot", "useful HTML/text availability", "accurate control semantics", "truthful llms.txt/Agent Skills/API/MCP/A2A/WebMCP surfaces", "no implied side-effect authorization", "snippet/citation controls match publisher intent"]
    },
    {
      "id": "feeds-manifests-api-machine-surfaces",
      "priority": "P2",
      "checks": ["RSS/Atom when present", "web manifest/icons when present", "public JSON/CSV/API/download content types", "public data caching/CORS where applicable", "no stale/private resources in catalogs"]
    },
    {
      "id": "freshness-lifecycle-regression",
      "priority": "P1",
      "checks": ["truthful sitemap lastmod", "date/version consistency", "deprecated-content handling", "shared-template blast radius", "content-page footer/metadata family regressions", "re-audit changed pages and affected archetypes", "scheduled regression evidence"]
    }
  ],
  "conditionalPacks": [
    {"id": "ecommerce-product", "trigger": "products, prices or checkout", "checks": ["Product/Offer parity", "price/currency/availability", "shipping/returns", "cart/checkout", "merchant-feed consistency"]},
    {"id": "editorial-news", "trigger": "articles/news/recurring authors", "checks": ["author identity", "publication/modified dates", "article markup", "provenance/corrections", "archive/topic discovery", "content-page quality contract"]},
    {"id": "dataset-research", "trigger": "datasets/research/benchmarks", "checks": ["Dataset metadata", "license/version/checksums", "persistent identifiers", "methodology/provenance", "reproducible downloads", "citation instructions"]},
    {"id": "tool-app-account", "trigger": "interactive app/accounts/uploads/saved state", "checks": ["authentication/accessibility", "error/recovery", "state persistence", "privacy lifecycle", "application-security review", "critical task completion"]},
    {"id": "local-business", "trigger": "physical location/service area", "checks": ["name/address/phone", "hours", "map/contact route", "LocalBusiness applicability", "service-area truth", "local-page uniqueness"]},
    {"id": "media-heavy", "trigger": "video/audio/image-led content", "checks": ["captions/transcripts", "poster/thumbnail", "media metadata", "image byte/dimension/format inventory", "responsive delivery and loading priority", "stream/download behavior", "media sitemap", "creator/provenance/licensing/visible credits", "bandwidth"]}
  ],
  "completionReportRequired": [
    "coverage state and exact discovered/in-scope/audited/browser-tested/excluded/unknown counts",
    "inventory reconciliation and unexplained gaps",
    "per-page ledger or machine-readable equivalent including applicableContracts",
    "applicability ledger proving every applicable audit/linked-contract rule was evaluated",
    "content/detail page count and CPQ pass/fail/watch/owner-data/not-applicable/unknown coverage",
    "site/system findings",
    "P0/P1/P2 plus watch/owner-data/not-applicable/unknown findings",
    "evidence layer for every material finding",
    "autofixed versus manual/owner/runtime gates",
    "verification and tested revision/deployment identity",
    "explicit surfaces not checked",
    "no composite SEO/AI/accessibility/security score substituting for evidence"
  ],
  "sources": [
    {"id": "google-search-essentials", "url": "https://developers.google.com/search/docs/essentials"},
    {"id": "google-page-experience", "url": "https://developers.google.com/search/docs/appearance/page-experience"},
    {"id": "google-structured-data", "url": "https://developers.google.com/search/docs/appearance/structured-data/sd-policies"},
    {"id": "google-js-seo", "url": "https://developers.google.com/search/docs/crawling-indexing/javascript/javascript-seo-basics"},
    {"id": "google-image-metadata", "url": "https://developers.google.com/search/docs/appearance/structured-data/image-license-metadata"},
    {"id": "mdn-img", "url": "https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/img"},
    {"id": "open-graph-protocol", "url": "https://ogp.me/"},
    {"id": "mdn-web-share", "url": "https://developer.mozilla.org/en-US/docs/Web/API/Web_Share_API"},
    {"id": "wcag22", "url": "https://www.w3.org/TR/WCAG22/"},
    {"id": "web-vitals", "url": "https://web.dev/articles/vitals"},
    {"id": "owasp-http-headers", "url": "https://cheatsheetseries.owasp.org/cheatsheets/HTTP_Headers_Cheat_Sheet.html"},
    {"id": "openai-publishers", "url": "https://help.openai.com/en/articles/12627856"},
    {"id": "bing-webmaster-guidelines", "url": "https://www.bing.com/webmasters/help/webmaster-guidelines-30fba23a"}
  ]
}
