{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/main/monitor/config.schema.json",
  "title": "ARWP Resolver Monitor Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sites"],
  "properties": {
    "version": { "const": "0.1" },
    "sites": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    },
    "failOn": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["any", "identity", "source-removed", "interface-removed", "conflict-added", "plan-changed", "resolution-failed"]
      }
    }
  }
}
