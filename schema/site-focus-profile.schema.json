{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/main/schema/site-focus-profile.schema.json",
  "title": "Cite Goose Site Focus Profile",
  "description": "Owner-declared problem boundary and information-architecture intent. This is product intent, not a ranking configuration.",
  "type": "object",
  "required": ["version", "canonicalUrl", "thesis", "scope", "problemLanes", "primaryNavigation", "routeRules"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": { "const": "0.2" },
    "canonicalUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "thesis": {
      "type": "object",
      "required": ["primaryProblem", "primaryAudience", "usefulOutcome", "distinctEvidence", "primaryAction"],
      "properties": {
        "primaryProblem": { "type": "string", "minLength": 8 },
        "primaryAudience": { "type": "string", "minLength": 3 },
        "usefulOutcome": { "type": "string", "minLength": 8 },
        "distinctEvidence": { "type": "string", "minLength": 8 },
        "primaryAction": { "type": "string", "minLength": 3 }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["in", "adjacent", "out"],
      "properties": {
        "in": { "type": "array", "items": { "type": "string", "minLength": 2 }, "uniqueItems": true },
        "adjacent": { "type": "array", "items": { "type": "string", "minLength": 2 }, "uniqueItems": true },
        "out": { "type": "array", "items": { "type": "string", "minLength": 2 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "problemLanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "label", "job"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 2 },
          "job": { "type": "string", "minLength": 4 }
        },
        "additionalProperties": false
      }
    },
    "primaryNavigation": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "routeRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["match", "role", "scope"],
        "properties": {
          "match": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "properties": {
              "path": { "type": "string", "pattern": "^/" },
              "pathPrefix": { "type": "string", "pattern": "^/" }
            },
            "additionalProperties": false
          },
          "role": {
            "enum": ["problem-commercial", "proof-portfolio", "trust-utility", "technical-reference", "localization-equivalent"]
          },
          "scope": { "enum": ["IN", "ADJACENT", "OUT"] },
          "lane": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "locales": {
      "type": "object",
      "required": ["default", "prefixes"],
      "properties": {
        "default": { "type": "string", "minLength": 2 },
        "prefixes": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^/" }
        }
      },
      "additionalProperties": false
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
