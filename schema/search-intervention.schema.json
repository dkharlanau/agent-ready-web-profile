{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/main/schema/search-intervention.schema.json",
  "title": "ARWP Search Intervention v0.1",
  "description": "Public-safe contract linking an intent-specific Search Maturity change to baseline evidence, exact changed dimensions/URLs, verification, controls/confounders and separately observed Search/AI/business outcomes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "id", "site", "intent", "hypothesis", "disclosure", "baseline", "intervention", "outcomeWindows", "observations", "confounders", "disposition", "confidence", "guardrails"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": { "const": "0.1" },
    "kind": { "const": "search-intervention" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,119}$" },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "siteClass", "ownership"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "siteClass": { "type": "string", "minLength": 2, "maxLength": 120 },
        "ownership": { "const": "owner-controlled" }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "locale"],
      "properties": {
        "family": { "type": "string", "minLength": 2, "maxLength": 160 },
        "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
        "queryCohortRef": { "type": "string", "minLength": 8, "maxLength": 500 }
      }
    },
    "hypothesis": { "type": "string", "minLength": 20, "maxLength": 3000 },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "containsLiveCorpus", "containsLearnedPriors", "ipReviewRequired"],
      "properties": {
        "class": { "type": "string", "enum": ["public-methodology", "public-fixture", "commercial-private", "confidential-rd", "defensive-publication"] },
        "containsLiveCorpus": { "type": "boolean" },
        "containsLearnedPriors": { "type": "boolean" },
        "ipReviewRequired": { "type": "boolean" }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturedAt", "surfaces"],
      "properties": {
        "capturedAt": { "type": "string", "format": "date-time" },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "provenanceClass", "evidenceRefs"],
            "properties": {
              "name": { "type": "string", "minLength": 2, "maxLength": 160 },
              "provenanceClass": { "type": "string", "enum": ["owner-evidence", "research-observation", "platform-documentation", "synthetic-fixture"] },
              "evidenceRefs": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 8, "maxLength": 500 } }
            }
          }
        },
        "notes": { "type": "string", "maxLength": 3000 }
      }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "changedUrls", "changedDimensions", "verification"],
      "properties": {
        "status": { "type": "string", "enum": ["planned", "source-implemented", "build-verified", "deployed-verified"] },
        "changedUrls": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } },
        "changedDimensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["retrievalClarity", "topicalFocus", "answerFirst", "evidenceDensity", "firstPartyEvidence", "authorEntityIdentity", "siteTransparency", "semanticStructure", "structuredDataIntegrity", "internalTopicalGraph", "freshnessIntegrity", "urlStability", "multimodalEvidence", "externalCorroboration", "utilitySurface", "agentAccessibility"] }
        },
        "implementedAt": { "type": "string", "format": "date-time" },
        "commitSha": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
        "linkedGrowthExperimentId": { "type": "string", "minLength": 3, "maxLength": 120 },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "evidenceRefs"],
          "properties": {
            "state": { "type": "string", "enum": ["not-run", "source-implemented", "build-verified", "deployed-verified"] },
            "evidenceRefs": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 8, "maxLength": 500 } }
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urls"],
      "properties": {
        "urls": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } },
        "notes": { "type": "string", "maxLength": 3000 }
      }
    },
    "outcomeWindows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["days"],
        "properties": {
          "days": { "type": "integer", "minimum": 0, "maximum": 3650 },
          "dueAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "channel", "observedAt", "state", "evidenceRefs"],
        "properties": {
          "phase": { "type": "string", "enum": ["baseline", "follow-up"] },
          "channel": { "type": "string", "enum": ["crawl-index", "classic-search-visibility", "ai-retrieval", "ai-citation", "answer-absorption", "referral", "useful-action", "product-continuation", "conversion"] },
          "observedAt": { "type": "string", "format": "date-time" },
          "windowDays": { "type": "integer", "minimum": 0, "maximum": 3650 },
          "state": { "type": "string", "enum": ["positive", "negative", "neutral", "inconclusive", "not-observed"] },
          "evidenceRefs": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 8, "maxLength": 500 } },
          "notes": { "type": "string", "maxLength": 3000 }
        }
      }
    },
    "confounders": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "disposition": { "type": "string", "enum": ["support", "neutral", "negative", "inconclusive"] },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noRankingGuarantee", "noCausalityInference", "preserveNegativeResults", "separateOutcomeChannels", "humanReviewBeforeLearning"],
      "properties": {
        "noRankingGuarantee": { "const": true },
        "noCausalityInference": { "const": true },
        "preserveNegativeResults": { "const": true },
        "separateOutcomeChannels": { "const": true },
        "humanReviewBeforeLearning": { "const": true }
      }
    }
  }
}
