{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/main/schema/technical-integrity-report.schema.json",
  "title": "Goose Technical Integrity Report",
  "type": "object",
  "required": ["version", "rulesVersion", "generatedAt", "canonicalUrl", "summary", "cohort", "robots", "pages", "checks", "guardrails", "registry"],
  "not": { "required": ["score"] },
  "properties": {
    "version": { "const": "0.2" },
    "rulesVersion": { "const": "0.2" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "canonicalUrl": { "type": "string", "format": "uri" },
    "summary": {
      "type": "object",
      "required": ["counts", "p0Failures", "state"],
      "properties": {
        "p0Failures": { "type": "integer", "minimum": 0 },
        "state": { "enum": ["blocked", "review", "clean"] }
      },
      "additionalProperties": true
    },
    "cohort": {
      "type": "object",
      "required": ["selectedPages", "urls"],
      "properties": {
        "selectedPages": { "type": "integer", "minimum": 1, "maximum": 50 },
        "urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "type": "string", "format": "uri" }
        }
      },
      "additionalProperties": true
    },
    "robots": {
      "type": "object",
      "required": ["url", "ok", "status"],
      "additionalProperties": true
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "type": "object", "additionalProperties": true }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "priority", "authority", "status", "message", "evidence", "source", "doesNotProve"],
        "properties": {
          "priority": { "enum": ["P0", "P1", "P2"] },
          "status": { "enum": ["pass", "fail", "watch", "not-applicable"] },
          "evidence": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "guardrails": {
      "type": "object",
      "required": [
        "noCompositeScore",
        "noRankingPromise",
        "noCitationPromise",
        "boundedSampleNotSiteWideProof",
        "boundedFetchFailureIsNotIndexabilityFailure",
        "nonHtmlDoesNotRequireHtmlCanonical",
        "watchIsNotFailure",
        "derivedHeuristicsAreNotPlatformRequirements"
      ],
      "properties": {
        "noCompositeScore": { "const": true },
        "noRankingPromise": { "const": true },
        "noCitationPromise": { "const": true },
        "boundedFetchFailureIsNotIndexabilityFailure": { "const": true },
        "nonHtmlDoesNotRequireHtmlCanonical": { "const": true }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
