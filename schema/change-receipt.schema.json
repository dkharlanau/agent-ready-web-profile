{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/main/schema/change-receipt.schema.json",
  "title": "SignalBraid Change Receipt v0.1",
  "description": "Content-addressed, append/revision-safe evidence record connecting source/rule lineage, exact target mutation, verification, deployment and later outcomes without embedding private rollback material.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "receiptId", "changeId", "revision", "previousReceiptId", "createdAt", "site", "repository", "source", "mutation", "verification", "deployment", "outcomes", "knowledge", "review", "boundaries", "digests"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": { "const": "0.1" },
    "receiptId": { "$ref": "#/$defs/urnDigest" },
    "changeId": { "$ref": "#/$defs/urnDigest" },
    "revision": { "type": "integer", "minimum": 1 },
    "previousReceiptId": { "anyOf": [{ "$ref": "#/$defs/urnDigest" }, { "type": "null" }] },
    "createdAt": { "type": "string", "format": "date-time" },
    "site": { "type": "string", "format": "uri", "pattern": "^https://" },
    "repository": { "$ref": "#/$defs/repository" },
    "source": { "$ref": "#/$defs/source" },
    "mutation": { "$ref": "#/$defs/mutation" },
    "verification": { "$ref": "#/$defs/verification" },
    "deployment": { "$ref": "#/$defs/deployment" },
    "outcomes": { "$ref": "#/$defs/outcomes" },
    "knowledge": { "$ref": "#/$defs/knowledge" },
    "review": { "$ref": "#/$defs/review" },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptIsMutationAuthorization", "receiptIsRankingEvidence", "verificationIsOutcome", "rollbackContentEmbedded", "missingOwnerEvidenceIsZero", "historicalRevisionMutable", "externalEvidenceDuplicated"],
      "properties": {
        "receiptIsMutationAuthorization": { "const": false },
        "receiptIsRankingEvidence": { "const": false },
        "verificationIsOutcome": { "const": false },
        "rollbackContentEmbedded": { "const": false },
        "missingOwnerEvidenceIsZero": { "const": false },
        "historicalRevisionMutable": { "const": false },
        "externalEvidenceDuplicated": { "const": false }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "payload"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "type": "string", "minLength": 1 },
        "payload": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "urnDigest": { "type": "string", "pattern": "^urn:sha256:[a-f0-9]{64}$" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fullName", "baseRef", "baseCommitSha"],
      "properties": {
        "fullName": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "baseRef": { "type": "string", "minLength": 1 },
        "baseCommitSha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "generatedAt", "digest"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": ["string", "null"], "format": "date-time" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "evidenceReceiptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptId", "payloadDigest", "role", "canonicalUrl", "observedAt"],
      "properties": {
        "receiptId": { "$ref": "#/$defs/urnDigest" },
        "payloadDigest": { "$ref": "#/$defs/digest" },
        "role": { "type": "string", "minLength": 1 },
        "canonicalUrl": { "type": ["string", "null"], "format": "uri" },
        "observedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "ruleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "nodeId", "versionKey", "state", "sourceNodeIds"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "minLength": 1 },
        "versionKey": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "sourceNodeIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "url", "versionKey", "state", "authority"],
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "versionKey": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "authority": { "type": ["string", "null"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transformationBundle", "adaptiveUpgradeDigest", "braidGraph", "recommendationIds", "ruleRefs", "sourceRefs", "evidenceReceipts"],
      "properties": {
        "transformationBundle": { "$ref": "#/$defs/artifactRef" },
        "adaptiveUpgradeDigest": { "$ref": "#/$defs/digest" },
        "braidGraph": { "$ref": "#/$defs/artifactRef" },
        "recommendationIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "ruleRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ruleRef" } },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
        "evidenceReceipts": { "type": "array", "items": { "$ref": "#/$defs/evidenceReceiptRef" } }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "recommendationId", "path", "operation", "automationClass", "beforeSha256", "afterSha256", "humanReviewRequired", "groundedEvidence"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1 },
        "recommendationId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "automationClass": { "type": "string", "minLength": 1 },
        "beforeSha256": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "afterSha256": { "$ref": "#/$defs/digest" },
        "humanReviewRequired": { "type": "boolean" },
        "groundedEvidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "githubExecution": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["branch", "commitSha", "pullRequestNumber", "pullRequestUrl"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "pullRequestNumber": { "type": "integer", "minimum": 1 },
        "pullRequestUrl": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "executionKind", "executedAt", "executionEvidenceDigest", "changes", "github", "rollback"],
      "properties": {
        "state": { "enum": ["planned", "applied-local", "pr-opened", "merged", "deployed", "rolled-back", "failed"] },
        "executionKind": { "enum": ["none", "local", "github-pr"] },
        "executedAt": { "type": ["string", "null"], "format": "date-time" },
        "executionEvidenceDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "changes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/change" } },
        "github": { "$ref": "#/$defs/githubExecution" },
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "evidenceDigest"],
          "properties": {
            "state": { "enum": ["not-applicable", "private-material-available", "performed", "failed"] },
            "evidenceDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
          }
        }
      }
    },
    "verificationObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operationId", "status", "kind", "observedAt", "evidenceRefs", "note"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "operationId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "unknown"] },
        "kind": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "note": { "type": ["string", "null"] }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "expected", "observations"],
      "properties": {
        "status": { "enum": ["unknown", "passed", "failed", "mixed"] },
        "expected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operationId", "check"],
            "properties": {
              "operationId": { "type": "string", "minLength": 1 },
              "check": { "type": "string", "minLength": 1 }
            }
          }
        },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/verificationObservation" } }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "observedAt", "commitSha", "url", "evidenceRefs"],
      "properties": {
        "state": { "enum": ["unknown", "not-deployed", "deployed", "failed"] },
        "observedAt": { "type": ["string", "null"], "format": "date-time" },
        "commitSha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
        "url": { "type": ["string", "null"], "format": "uri" },
        "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "outcomeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operationId", "status", "kind", "provider", "metric", "value", "observedAt", "evidenceClass", "evidenceRefs", "note"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "operationId": { "type": ["string", "null"] },
        "status": { "enum": ["observed", "positive", "negative", "neutral", "mixed", "unknown"] },
        "kind": { "type": "string", "minLength": 1 },
        "provider": { "type": ["string", "null"] },
        "metric": { "type": ["string", "null"] },
        "value": {},
        "observedAt": { "type": "string", "format": "date-time" },
        "evidenceClass": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "note": { "type": ["string", "null"] }
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "expectedSignals", "observations"],
      "properties": {
        "status": { "enum": ["unknown", "observed", "positive", "negative", "neutral", "mixed"] },
        "expectedSignals": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/outcomeObservation" } }
      }
    },
    "ruleState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "originalNodeId", "originalVersionKey", "originalState", "currentNodeId", "currentVersionKey", "currentState", "changed"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "originalNodeId": { "type": "string", "minLength": 1 },
        "originalVersionKey": { "type": "string", "minLength": 1 },
        "originalState": { "type": "string", "minLength": 1 },
        "currentNodeId": { "type": ["string", "null"] },
        "currentVersionKey": { "type": ["string", "null"] },
        "currentState": { "type": ["string", "null"] },
        "changed": { "type": "boolean" }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reReviewRequired", "checkedAt", "braidGraphDigest", "ruleStates"],
      "properties": {
        "reReviewRequired": { "type": "boolean" },
        "checkedAt": { "type": "string", "format": "date-time" },
        "braidGraphDigest": { "$ref": "#/$defs/digest" },
        "ruleStates": { "type": "array", "items": { "$ref": "#/$defs/ruleState" } }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reviewedAt", "note"],
      "properties": {
        "decision": { "enum": ["pending", "keep", "revise", "revert", "retire", "continue-measuring"] },
        "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
        "note": { "type": ["string", "null"] }
      }
    }
  }
}
