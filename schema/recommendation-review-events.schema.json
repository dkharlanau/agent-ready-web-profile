{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/main/schema/recommendation-review-events.schema.json",
  "title": "Goose Recommendation Review Events v0.1",
  "description": "Reviewed evidence events that can place a Search/AI recommendation into a review queue. Events never mutate the recommendation registry automatically.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "events"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": { "const": "0.1" },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ruleId", "observedAt", "kind", "evidenceUri"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,159}$" },
          "ruleId": { "type": "string", "minLength": 2, "maxLength": 200 },
          "observedAt": { "type": "string", "format": "date-time" },
          "kind": {
            "type": "string",
            "enum": [
              "source-changed",
              "provider-contradiction",
              "independent-challenge",
              "winner-counterexample",
              "experiment-positive",
              "experiment-neutral",
              "experiment-negative",
              "manual-retire-proposal"
            ]
          },
          "evidenceUri": { "type": "string", "format": "uri" },
          "note": { "type": "string", "maxLength": 3000 }
        }
      }
    }
  }
}
