{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/main/schema/adaptive-upgrade-graph.schema.json",
  "title": "ARWP Adaptive Site Upgrade Graph v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "site", "context", "knowledge", "summary", "sourceDebt", "recommendations", "waves", "guardrails"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": { "const": "0.1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "site": { "type": "string", "format": "uri", "pattern": "^https://" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verticals", "goals"],
      "properties": {
        "verticals": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "goals": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryVersion", "ruleset", "reviewedAt", "current", "reviewDue"],
      "properties": {
        "registryVersion": { "type": "string" },
        "ruleset": { "type": "string" },
        "reviewedAt": { "type": "string", "format": "date" },
        "current": { "type": "integer", "minimum": 0 },
        "reviewDue": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended", "conditional", "reviewDue", "byPriority", "byAutomationClass"],
      "properties": {
        "recommended": { "type": "integer", "minimum": 0 },
        "conditional": { "type": "integer", "minimum": 0 },
        "reviewDue": { "type": "integer", "minimum": 0 },
        "byPriority": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "byAutomationClass": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "sourceDebt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionIds", "verticalCheckIds"],
      "properties": {
        "actionIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "verticalCheckIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "recommendations": {
      "type": "array",
      "items": { "$ref": "#/$defs/recommendation" }
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "recommendationIds"],
        "properties": {
          "priority": { "type": "string" },
          "recommendationIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noRankingGuarantee", "noInventedFacts", "ownerDataSeparate", "productionMutationAuthorized", "staleKnowledgeNeedsReview", "negativeResultsPreserved"],
      "properties": {
        "noRankingGuarantee": { "const": true },
        "noInventedFacts": { "const": true },
        "ownerDataSeparate": { "const": true },
        "productionMutationAuthorized": { "const": false },
        "staleKnowledgeNeedsReview": { "const": true },
        "negativeResultsPreserved": { "const": true }
      }
    }
  },
  "$defs": {
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "priority", "lane", "state", "knowledgeState", "authority", "reason", "sources", "change", "verification", "measurement", "dependencies", "addresses", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "priority": { "type": "string" },
        "lane": { "type": "string" },
        "state": { "enum": ["recommended", "conditional"] },
        "knowledgeState": { "enum": ["current", "review-due"] },
        "authority": { "type": "string" },
        "reason": { "type": "string" },
        "condition": { "type": ["string", "null"] },
        "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
        "change": {
          "type": "object",
          "additionalProperties": false,
          "required": ["automationClass", "targets", "recipe"],
          "properties": {
            "automationClass": { "type": "string" },
            "targets": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "recipe": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checks", "successState"],
          "properties": {
            "checks": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "successState": { "type": "string", "minLength": 1 }
          }
        },
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signals", "ownerDataRequired"],
          "properties": {
            "signals": { "type": "array", "items": { "type": "string" } },
            "ownerDataRequired": { "type": "boolean" }
          }
        },
        "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "addresses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actionIds", "verticalCheckIds"],
          "properties": {
            "actionIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "verticalCheckIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
          }
        },
        "evidence": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
