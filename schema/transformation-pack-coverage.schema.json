{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/main/schema/transformation-pack-coverage.schema.json",
  "title": "SignalBraid Transformation Pack Coverage Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "observations"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "version": { "const": "0.1" },
    "observedAt": { "type": "string", "format": "date-time" },
    "portfolioId": { "type": "string", "minLength": 1 },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["siteId", "result"],
        "properties": {
          "siteId": { "type": "string", "minLength": 1 },
          "canonicalUrl": { "type": "string", "format": "uri" },
          "repository": { "type": "string", "minLength": 1 },
          "adapter": { "type": "string", "minLength": 1 },
          "evidenceRef": { "type": "string", "minLength": 1 },
          "result": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "version": { "type": "string" },
              "packId": { "type": "string", "minLength": 1 },
              "recipeId": { "type": "string", "minLength": 1 },
              "status": { "enum": ["ready", "no-op", "blocked"] },
              "reason": { "type": ["string", "null"] },
              "detail": {},
              "path": { "type": "string", "minLength": 1 },
              "evidence": { "type": "object" },
              "operationSpec": {},
              "boundaries": { "type": "object" }
            },
            "additionalProperties": true
          }
        }
      }
    }
  }
}
