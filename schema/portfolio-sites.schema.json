{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/main/schema/portfolio-sites.schema.json",
  "title": "ARWP owner portfolio sites v0.1",
  "description": "Owner-controlled rollout metadata for mapping reviewed Search/AI trends to relevant sites. This is operational metadata, not an adoption directory or quality ranking.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updatedAt", "description", "guardrails", "sites"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": { "const": "0.1" },
    "updatedAt": { "type": "string", "format": "date" },
    "description": { "type": "string", "minLength": 1 },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerControlledEvidence", "watchIsNotDefaultRollout", "siteAuditRequiredBeforeMutation", "noProductionMutation", "noRankingInference"],
      "properties": {
        "ownerControlledEvidence": { "const": true },
        "watchIsNotDefaultRollout": { "const": true },
        "siteAuditRequiredBeforeMutation": { "const": true },
        "noProductionMutation": { "const": true },
        "noRankingInference": { "const": true }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/site" }
    }
  },
  "$defs": {
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "canonicalUrl", "repository", "verticals", "rollout"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "canonicalUrl": { "$ref": "#/$defs/httpsUrl" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "verticals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["general", "documentation", "editorial", "software-product", "commerce", "local-business", "research-dataset"]
          }
        },
        "goals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["search", "generative-search", "ai-citations", "acquisition", "measurement", "agent-usability", "agent-discovery"]
          }
        },
        "rollout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "mode"],
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "enum": ["managed-issue", "proposal-only", "observe-only"] },
            "providers": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 80 }
            },
            "excludeTrendIds": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 2, "maxLength": 180 }
            }
          }
        }
      }
    }
  }
}
