{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/main/schema/watch-targets.schema.json",
  "title": "SignalBraid Watch Targets v0.1",
  "description": "Local/owner-controlled manifest pointing SignalBraid Watch at one or more existing BraidGraph artifacts. Site importance is explicit operator metadata and is never inferred from rankings or traffic.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sites"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": { "const": "0.1" },
    "sites": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "graph", "importance", "enabled"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$" },
          "graph": { "type": "string", "minLength": 1, "maxLength": 500 },
          "importance": { "enum": ["critical", "high", "normal", "low"] },
          "enabled": { "type": "boolean" },
          "portfolioSiteId": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        }
      }
    }
  }
}
