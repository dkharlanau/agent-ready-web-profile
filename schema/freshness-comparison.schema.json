{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/main/schema/freshness-comparison.schema.json",
  "title": "Goose Freshness Integrity Comparison v0.1",
  "description": "Longitudinal comparison of sitemap lastmod with revision-bound mapped source/build input digests. Findings require review and do not prove ranking or crawling effects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "generatedAt", "site", "repository", "before", "after", "summary", "observations", "actions", "sources", "guardrails"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": { "const": "0.1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "site": { "type": "string", "format": "uri", "pattern": "^https://" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "before": { "$ref": "#/$defs/snapshotRef" },
    "after": { "$ref": "#/$defs/snapshotRef" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urls", "comparable", "lastmodChurnCandidates", "staleLastmodCandidates", "alignedChanges", "unchanged", "added", "removed", "unknown"],
      "properties": {
        "urls": { "type": "integer", "minimum": 0 },
        "comparable": { "type": "integer", "minimum": 0 },
        "lastmodChurnCandidates": { "type": "integer", "minimum": 0 },
        "staleLastmodCandidates": { "type": "integer", "minimum": 0 },
        "alignedChanges": { "type": "integer", "minimum": 0 },
        "unchanged": { "type": "integer", "minimum": 0 },
        "added": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 }
      }
    },
    "observations": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/observation" } },
    "actions": { "type": "array", "maxItems": 50000, "items": { "$ref": "#/$defs/action" } },
    "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noRankingPromise", "noRecrawlPromise", "digestEqualityNotRenderedProof", "digestChangeNotSignificantChangeProof", "unknownRemainsUnknown", "noCompositeScore", "negativeResultsPreserved"],
      "properties": {
        "noRankingPromise": { "const": true },
        "noRecrawlPromise": { "const": true },
        "digestEqualityNotRenderedProof": { "const": true },
        "digestChangeNotSignificantChangeProof": { "const": true },
        "unknownRemainsUnknown": { "const": true },
        "noCompositeScore": { "const": true },
        "negativeResultsPreserved": { "const": true }
      }
    }
  },
  "$defs": {
    "snapshotRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedAt", "baseRef", "baseCommitSha", "sitemapSha256"],
      "properties": {
        "generatedAt": { "type": "string", "format": "date-time" },
        "baseRef": { "type": "string", "minLength": 1 },
        "baseCommitSha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "sitemapSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "state", "beforeLastmod", "afterLastmod", "ownerChanged", "mappedInputsChanged", "confidence", "reason"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "state": { "enum": ["lastmod-churn-candidate", "stale-lastmod-candidate", "aligned-change", "unchanged", "added", "removed", "unknown"] },
        "beforeLastmod": { "type": ["string", "null"] },
        "afterLastmod": { "type": ["string", "null"] },
        "ownerChanged": { "type": ["boolean", "null"] },
        "mappedInputsChanged": { "type": ["boolean", "null"] },
        "confidence": { "enum": ["high", "medium", "low", "not-applicable"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 3000 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "status", "url", "kind", "reason", "verification", "source", "doesNotProve"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 240 },
        "priority": { "enum": ["P1", "P2"] },
        "status": { "const": "review" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "kind": { "enum": ["review-synthetic-lastmod", "review-stale-lastmod"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "verification": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "source": { "type": "string", "format": "uri", "pattern": "^https://" },
        "doesNotProve": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
