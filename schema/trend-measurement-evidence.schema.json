{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/main/schema/trend-measurement-evidence.schema.json",
  "title": "ARWP Trend MEASURED Evidence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "trends", "proposals", "guardrails"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": { "const": "0.1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "trends": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trendId", "provider", "currentStage", "linkedActionRefs", "totalExperiments", "reviewedExperiments", "ownerEvidenceExperiments", "sites", "outcomes", "reviewDecisions", "eligibility"],
        "properties": {
          "trendId": { "type": "string" },
          "provider": { "type": "string" },
          "currentStage": { "type": "string", "enum": ["watch", "adopt", "measured", "retired"] },
          "linkedActionRefs": { "type": "array", "items": { "type": "string" } },
          "totalExperiments": { "type": "integer", "minimum": 0 },
          "reviewedExperiments": { "type": "integer", "minimum": 0 },
          "ownerEvidenceExperiments": { "type": "integer", "minimum": 0 },
          "sites": { "type": "array", "items": { "type": "string", "format": "uri" } },
          "outcomes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["positive", "negative", "mixed", "noChange", "ownerEvidenceUnavailable"],
            "properties": {
              "positive": { "type": "integer", "minimum": 0 },
              "negative": { "type": "integer", "minimum": 0 },
              "mixed": { "type": "integer", "minimum": 0 },
              "noChange": { "type": "integer", "minimum": 0 },
              "ownerEvidenceUnavailable": { "type": "integer", "minimum": 0 }
            }
          },
          "reviewDecisions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["keep", "revise", "revert", "retire", "continueMeasuring"],
            "properties": {
              "keep": { "type": "integer", "minimum": 0 },
              "revise": { "type": "integer", "minimum": 0 },
              "revert": { "type": "integer", "minimum": 0 },
              "retire": { "type": "integer", "minimum": 0 },
              "continueMeasuring": { "type": "integer", "minimum": 0 }
            }
          },
          "eligibility": { "type": "string", "enum": ["eligible-for-review", "already-measured", "not-adopted", "retired", "no-linked-actions", "insufficient-owner-evidence"] }
        }
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "trendId", "currentStage", "proposedStage", "status", "evidenceExperimentIds", "sites", "note"],
        "properties": {
          "id": { "type": "string" },
          "trendId": { "type": "string" },
          "currentStage": { "const": "adopt" },
          "proposedStage": { "const": "measured" },
          "status": { "const": "review-required" },
          "evidenceExperimentIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "sites": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
          "note": { "type": "string" }
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noAutomaticMeasuredPromotion", "negativeAndNeutralResultsIncluded", "measuredMeansObservedNotPositive", "noCausalityInference"],
      "properties": {
        "noAutomaticMeasuredPromotion": { "const": true },
        "negativeAndNeutralResultsIncluded": { "const": true },
        "measuredMeansObservedNotPositive": { "const": true },
        "noCausalityInference": { "const": true }
      }
    }
  }
}
