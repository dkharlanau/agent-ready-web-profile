{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/main/schema/transformation-pack-registry.schema.json",
  "title": "SignalBraid Transformation Pack Registry v0.1",
  "description": "Declarative safety envelopes for stack-specific, ownership-backed Transformation Engine operation preparation. Packs prepare operation specs; they do not authorize or execute production mutation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "reviewedAt", "packs"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": { "const": "0.1" },
    "reviewedAt": { "type": "string", "format": "date" },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pack" }
    }
  },
  "$defs": {
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "description", "adapters", "recipes", "guardrails"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,100}$" },
        "version": { "const": "0.1" },
        "status": { "enum": ["active", "experimental", "retired"] },
        "description": { "type": "string", "minLength": 1 },
        "adapters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["static-html", "jekyll", "astro"] }
        },
        "recipes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/recipe" }
        },
        "guardrails": { "$ref": "#/$defs/guardrails" }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "ownershipScope", "automationClass", "allowedFileRoles", "allowedMutationClasses", "requiredInputs", "requiresReviewedGrounding", "verification"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,100}$" },
        "mode": { "enum": ["html-canonical-link", "html-jsonld-script", "machine-file-replace"] },
        "ownershipScope": { "enum": ["route", "surface"] },
        "automationClass": { "enum": ["mechanical", "grounded-template"] },
        "surfaceTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["document", "canonical", "jsonld", "robots-file", "sitemap", "llms", "agent-discovery", "api-description", "other-machine-surface"] }
        },
        "allowedFileRoles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["page-source", "machine-surface", "content", "data"] }
        },
        "allowedMutationClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["mechanical", "grounded-template"] }
        },
        "requiredInputs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "requiresReviewedGrounding": { "type": "boolean" },
        "verification": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exactOwnershipRequired", "digestPreconditionRequired", "noPathGuessing", "noProductionMutation", "noEditorialGeneration", "noPolicyMutation", "noOwnerPlatformMutation", "noRuntimeMutation", "unsupportedFailsClosed", "noRankingGuarantee"],
      "properties": {
        "exactOwnershipRequired": { "const": true },
        "digestPreconditionRequired": { "const": true },
        "noPathGuessing": { "const": true },
        "noProductionMutation": { "const": true },
        "noEditorialGeneration": { "const": true },
        "noPolicyMutation": { "const": true },
        "noOwnerPlatformMutation": { "const": true },
        "noRuntimeMutation": { "const": true },
        "unsupportedFailsClosed": { "const": true },
        "noRankingGuarantee": { "const": true }
      }
    }
  }
}
