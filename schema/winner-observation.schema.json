{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/main/schema/winner-observation.schema.json",
  "title": "Goose Winner Observatory Snapshot v0.1",
  "description": "Versioned observation of a fixed Search/AI query cohort. Records public or owner-observed result/citation state without inferring ranking factors or paid-acquisition absence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cohortId", "observedAt", "surface", "locale", "capture", "queries", "guardrails"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": { "const": "0.1" },
    "cohortId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,119}$" },
    "observedAt": { "type": "string", "format": "date-time" },
    "surface": {
      "type": "string",
      "enum": ["google-search", "google-ai-overview", "google-ai-mode", "bing-search", "bing-copilot", "chatgpt-search", "perplexity", "other-reviewed-surface"]
    },
    "locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}([_-][A-Za-z0-9]{2,8})?$" },
    "market": { "type": "string", "maxLength": 120 },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["manual-public-observation", "provider-owner-export", "reviewed-third-party-export", "controlled-browser-run", "other-reviewed"]
        },
        "evidenceUri": { "type": "string", "format": "uri" },
        "notes": { "type": "string", "maxLength": 3000 }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/queryObservation" }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noRankingFactorInference", "noCausalityInference", "paidAcquisitionUnknownUnlessVerified", "preserveNegativeResults"],
      "properties": {
        "noRankingFactorInference": { "const": true },
        "noCausalityInference": { "const": true },
        "paidAcquisitionUnknownUnlessVerified": { "const": true },
        "preserveNegativeResults": { "const": true }
      }
    }
  },
  "$defs": {
    "queryObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "results"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,119}$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "intent": { "type": "string", "maxLength": 160 },
        "results": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/resultObservation" }
        }
      }
    },
    "resultObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "citationState", "mentionState", "paidAcquisitionStatus"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "rank": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "citationState": { "type": "string", "enum": ["observed", "not-observed", "not-applicable", "unknown"] },
        "mentionState": { "type": "string", "enum": ["observed", "not-observed", "not-applicable", "unknown"] },
        "paidAcquisitionStatus": { "type": "string", "enum": ["unknown", "none-observed", "confirmed-present"] },
        "role": { "type": "string", "enum": ["target", "competitor", "control", "unclassified"] },
        "notes": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
