{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dkharlanau/agent-ready-web-profile/main/schema/intent-ownership.schema.json",
  "title": "ARWP Intent Ownership Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "reviewedAt", "site", "disclosure", "canonicalPages", "families", "guardrails"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": "0.1"},
    "kind": {"const": "intent-ownership-ledger"},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "ownership"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "ownership": {"const": "owner-controlled"}
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "containsLiveQueries"],
      "properties": {
        "class": {"enum": ["public-methodology", "public-fixture", "commercial-private", "confidential-rd"]},
        "containsLiveQueries": {"type": "boolean"}
      }
    },
    "canonicalPages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "indexState", "evidenceRefs"],
        "properties": {
          "url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "indexState": {"enum": ["indexable", "noindex", "redirect", "unknown"]},
          "canonicalUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
          "evidenceRefs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "locale", "ownershipConfidence", "ownerUrls", "supportingPages", "evidenceAssets", "observations"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,119}$"},
          "label": {"type": "string", "minLength": 1},
          "locale": {"type": "string", "minLength": 2},
          "ownershipConfidence": {"enum": ["low", "medium", "high"]},
          "ownerUrls": {"type": "array", "items": {"type": "string", "format": "uri", "pattern": "^https://"}},
          "supportingPages": {"type": "array", "items": {"type": "string", "format": "uri", "pattern": "^https://"}},
          "evidenceAssets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "evidenceRefs"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "type": {"type": "string", "minLength": 1},
                "url": {"type": "string", "format": "uri", "pattern": "^https://"},
                "evidenceRefs": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider", "surface", "phraseClass", "phrase", "observedAt", "pageUrl", "evidenceRefs"],
              "properties": {
                "provider": {"type": "string", "minLength": 1},
                "surface": {"type": "string", "minLength": 1},
                "phraseClass": {"enum": ["search-query", "grounding-query", "referral-intent", "manual-intent"]},
                "phrase": {"type": "string", "minLength": 1},
                "observedAt": {"type": "string", "format": "date-time"},
                "pageUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
                "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noPagePerQueryVariant", "noCannibalizationInference", "noRankingClaim", "noCrossProviderMetricJoin", "humanReviewBeforeMutation"],
      "properties": {
        "noPagePerQueryVariant": {"const": true},
        "noCannibalizationInference": {"const": true},
        "noRankingClaim": {"const": true},
        "noCrossProviderMetricJoin": {"const": true},
        "humanReviewBeforeMutation": {"const": true}
      }
    }
  }
}
