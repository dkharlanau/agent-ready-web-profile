    {
      "@id": "https://dkharlanau.github.io/agent-ready-web-profile/#term-agentic-web-interoperability-resolver",
      "@type": "DefinedTerm",
      "name": "agentic web interoperability resolver",
      "termCode": "agentic-web-interoperability-resolver",
      "description": "Project-defined class for developer infrastructure that discovers heterogeneous machine- and agent-facing interfaces exposed by a website, preserves source authority and conflicts, normalizes observations into an inspectable service map, and selects an interface for a concrete intent.",
      "url": "https://dkharlanau.github.io/agent-ready-web-profile/compare/",
      "inDefinedTermSet": {"@id": "https://dkharlanau.github.io/agent-ready-web-profile/#vocabulary"}
    },
    {
      "@id": "https://dkharlanau.github.io/agent-ready-web-profile/#term-agentic-web-resolver",
      "@type": "DefinedTerm",
      "name": "agentic web resolver",
      "description": "Software that discovers multiple machine- and agent-facing interfaces exposed by a website, preserves provenance, reports conflicts and selects an interface for a concrete intent.",
      "url": "https://dkharlanau.github.io/agent-ready-web-profile/concepts/agentic-web-resolver.html",
      "inDefinedTermSet": {"@id": "https://dkharlanau.github.io/agent-ready-web-profile/#vocabulary"}
    },
